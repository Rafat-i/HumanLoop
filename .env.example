# Local demonstration only. Never reuse these database credentials in production.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://humanloop:humanloop@localhost:5432/humanloop
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
DEMO_MODE=true
PAYMENT_PROVIDER=mock
# Optional test integration only. Replace these empty values locally with your
# own Stripe TEST key and webhook signing secret; never commit the filled file.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=false
PUBLIC_BOOKINGS_ENABLED=false
LLM_PROVIDER=deterministic
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
UPLOAD_DIR=uploads
MAIL_DIR=local-mail
SESSION_HOURS=24
